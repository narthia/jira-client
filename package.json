{
  "name": "@narthia/jira-client",
  "version": "1.1.3",
  "description": "A fully typed, tree-shakeable Jira REST API client generated from Atlassian's OpenAPI specs. Covers the Jira platform (v2/v3), Jira Software, and Jira Service Management. ESM-only with zero runtime dependencies.",
  "keywords": [
    "api",
    "atlassian",
    "client",
    "esm",
    "jira",
    "jira-api-client",
    "jira-client",
    "jira-rest-api",
    "jira-rest-client",
    "narthia",
    "narthia-jira",
    "narthia-rest",
    "nodejs",
    "openapi",
    "rest",
    "rest-api",
    "sdk",
    "secure",
    "tree-shakeable",
    "type-safe",
    "typescript",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/narthia/jira-client#readme",
  "bugs": {
    "url": "https://github.com/narthia/jira-client/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jeevan Karnati",
    "email": "jeevanreddy1999@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narthia/jira-client.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client/index.mjs",
    "./jira-platform-v2": "./dist/jira-platform-v2/index.mjs",
    "./jira-platform-v2/config": "./dist/jira-platform-v2/config.mjs",
    "./jira-platform-v3": "./dist/jira-platform-v3/index.mjs",
    "./jira-platform-v3/config": "./dist/jira-platform-v3/config.mjs",
    "./jira-service-desk": "./dist/jira-service-desk/index.mjs",
    "./jira-service-desk/config": "./dist/jira-service-desk/config.mjs",
    "./jira-software": "./dist/jira-software/index.mjs",
    "./jira-software/config": "./dist/jira-software/config.mjs",
    "./package.json": "./package.json",
    "./jira-platform-v2/services/*": {
      "types": "./dist/jira-platform-v2/services/*.d.mts",
      "import": "./dist/jira-platform-v2/services/*.mjs"
    },
    "./jira-platform-v3/services/*": {
      "types": "./dist/jira-platform-v3/services/*.d.mts",
      "import": "./dist/jira-platform-v3/services/*.mjs"
    },
    "./jira-service-desk/services/*": {
      "types": "./dist/jira-service-desk/services/*.d.mts",
      "import": "./dist/jira-service-desk/services/*.mjs"
    },
    "./jira-software/services/*": {
      "types": "./dist/jira-software/services/*.d.mts",
      "import": "./dist/jira-software/services/*.mjs"
    },
    "./transports/*": {
      "types": "./dist/transport/*.d.mts",
      "import": "./dist/transport/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "dev": "vp pack --watch",
    "generate": "openapi-sdk-generator -c ./narthia.config.ts",
    "prepublishOnly": "vp run check && vp run build",
    "spec-sync": "node spec-sync/sync.ts",
    "spec-sync:baseline": "node spec-sync/sync.ts --write-baseline",
    "spec-sync:dry-run": "node spec-sync/sync.ts --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@narthia/openapi-sdk-generator": "^0.6.0",
    "@narthia/toolkit": "^0.0.4",
    "@types/node": "^26.1.1",
    "eslint-plugin-check-file": "^3.3.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "^0.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.3.14"
}
